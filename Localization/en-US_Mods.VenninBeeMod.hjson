Items: {
	BoneRotBullet: {
		DisplayName: Bone Rot Bullet
		Tooltip: Rots what it hits, softening its attacks
	}

	HardenedBeeStinger: {
		DisplayName: Hardened Bee Stinger
		Tooltip: Calcified solid; still sharp after all this time
	}

	TatteredBeeHide: {
		DisplayName: Tattered Bee Hide
		Tooltip: Dry, holed and faintly buzzing. Still carries the rot
	}

	Prismwax: {
		DisplayName: Prismwax
		Tooltip: Comb that set into crystal when the Hallow took the hive
	}

	FracturedStinger: {
		DisplayName: Fractured Stinger
		Tooltip: Split clean through, and sharper for it
	}

	NectarLash: {
		DisplayName: Nectar Lash
		Tooltip:
			'''
			Coats what it strikes in nectar and sends your minions after it
			Your bees hit coated enemies harder, and they move slower for wearing it
			Hold the swing to feed the cord and reach further
			'''
	}

	PrismhiveBeacon: {
		DisplayName: Prismhive Beacon
		Tooltip:
			'''
			Plants a crystal hive wherever you point it
			Its shards refract into three on the way out, and it lets a bee go now and then
			'''
	}

	Combcaster: {
		DisplayName: Combcaster
		Tooltip:
			'''
			Lobs a comb that sticks where it lands and spits bees at anything near it
			Three combs at a time; a fourth retires the oldest
			'''
	}

	RotweaveShroud: {
		DisplayName: Rotweave Shroud
		Tooltip:
			'''
			Hide stripped from a skeleton bee and stitched back over its own bones
			Your bees leave Bone Rot in everything they sting
			Enemies pay you less attention
			'''
	}

	GorehiveMaul: {
		DisplayName: Gorehive Maul
		Tooltip:
			'''
			A slow, ugly swing that plants a grub in whatever it caves in
			The grub feeds for a few seconds, then comes out as a knot of bees
			'''
	}

	Hemobore: {
		DisplayName: Hemobore
		Tooltip:
			'''
			Fires barbs that stay in the wound and keep working
			Each one bleeds the target, feeds a thread of life back to you and sheds bees
			Three barbs at a time, and they tear loose if you stray too far
			'''
	}

	BroodCystStaff: {
		DisplayName: Brood Cyst Staff
		Tooltip:
			'''
			Lobs a cyst that grafts onto an enemy and swells
			It ruptures for a burst of gore and a swarm
			Land more on the same target to make the rupture far worse
			'''
	}

	BloodgorgerIdol: {
		DisplayName: Bloodgorger Idol
		Tooltip:
			'''
			Summons a parasite that clamps onto one enemy and drains it
			The longer it stays attached the harder it bites
			Several of them spread out rather than pile onto one target
			'''
	}

	HornetRift: {
		DisplayName: Hornet Rift
		Tooltip:
			'''
			Hold to hang a drone ahead of you that tears a rift open
			It spits shadow poisoned stingers at your cursor in bursts
			The longer you hold the channel the faster they come
			'''
	}

	ShadowHiveStaff: {
		DisplayName: Shadow Hive Staff
		Tooltip:
			'''
			Hangs a corrupted hive wherever you point it
			Steeps everything near it in shadow poison and lets drones out to hunt
			'''
	}

	PhantomHivebow: {
		DisplayName: Phantom Hivebow
		Tooltip:
			'''
			Hangs a line of ghost bees over your cursor that rake the ground below
			Eats five wooden arrows a volley; any other arrow rains from the sky for three
			'''
	}

	SilentSting: {
		DisplayName: Silent Sting
		Tooltip:
			'''
			A blur of a dagger that barely slows down between stabs
			Each hit drops a ninja bee into the target's blind spot to strike from behind
			'''
	}

	StrayQueenBee: {
		DisplayName: Stray Queen Bee
		Tooltip:
			'''
			A drifting court of bees slowly gathers around you
			They ignore your enemies, but sting anything that blunders into them
			'''
	}

	BuzzKill: {
		DisplayName: Buzz Kill
		Tooltip:
			'''
			Sprays fifteen heavy honey pellets in a wide arc
			Every pellet that lands hatches a bee that hunts what it hit
			'''
	}

	StingerLance: {
		DisplayName: Hive Lance
		Tooltip: Hold left click to shake out bees. Right click thrusts the hive forward.
	}

	HoneyDripperWand: {
		DisplayName: Honey Dripper Wand
		Tooltip: Fires sticky honey globs that heal.
	}

	SoulDripScepter: {
		DisplayName: Queen's Murmur
		Tooltip:
			'''
			Hold to gather a pheromone swarm of bees
			Release to send them toward your cursor
			'''
	}

	BeeSwarmComb: {
		DisplayName: Bee Swarm Comb
		Tooltip: Spawns a small bee minion.
	}

	QueensGuardCuirass: {
		DisplayName: Queens Guard Cuirass
		Tooltip: 5% increased melee damage.
	}

	QueensGuardGreaves: {
		DisplayName: Queens Guard Greaves
		Tooltip: 5% increased melee damage.
	}

	QueensGuardMask: {
		DisplayName: Queens Guard Mask
		Tooltip: 4% increased melee critical strike chance.
	}

	HivepiercerHood: {
		DisplayName: Hivepiercer Hood
		Tooltip: 6% increased ranged critical strike chance.
	}

	HivepiercerShell: {
		DisplayName: Hivepiercer Shell
		Tooltip: 6% increased ranged damage.
	}

	HivepiercerTarsi: {
		DisplayName: Hivepiercer Tarsi
		Tooltip: 10% increased movement speed
	}

	WaxweaverCowl: {
		DisplayName: Waxweaver Cowl
		Tooltip: 6% increased magic critical strike chance.
	}

	WaxweaverMantle: {
		DisplayName: Waxweaver Mantle
		Tooltip:
			'''
			6% increased magic damage.
			Increases maximum mana by 20.
			'''
	}

	WaxweaverSlippers: {
		DisplayName: Waxweaver Slippers
		Tooltip: Increases maximum mana by 20.
	}

	Projectiles: {
		StingerLanceProjectile.DisplayName: Stinger Lance Projectile
		StingerBeeShakerProjectile.DisplayName: Stinger Bee Shaker Projectile

		HoneyGlobProjectile: {
			Displayname: Honey Glob
			DisplayName: Honey Glob Projectile
		}

		BeeFollowerMinion.DisplayName: Bee Follower Minion
		HiveHornetMinion.DisplayName: Hive Hornet Minion
		BeeTrail.DisplayName: Bee Trail
	}

	Buffs: {
		BeeSwarmBuff: {
			DisplayName: Bee Swarm Buff
			Description: A swarm of bees follows you!
		}

		QueensHoney: {
			DisplayName: Queens Honey
			Description: Huge life regeneration.
		}

		HiveMindBuff: {
			DisplayName: Hive Mind Buff
			Description: A large bee helps you shoot!
		}
	}

	StickyResin: {
		DisplayName: Sticky Resin
		Tooltip: Used to make bee related items.
	}

	StickyTwigWand: {
		DisplayName: Sticky Twig Wand
		Tooltip: Shoot a stream of honey that can heal friends.
	}

	PocketBees: {
		DisplayName: Pocket Bees
		Tooltip: Throw a bunch of bees?
	}

	HiveballFlail: {
		DisplayName: Hiveball Flail
		Tooltip: Sling a whole hive!
	}

	MakeshiftHiveStaff: {
		DisplayName: Makeshift Hive Staff
		Tooltip: Creates a bee hive turret.
	}

	RoyalHoneyBrooch: {
		DisplayName: Royal Honey Brooch
		Tooltip: Create a healing bee at 1/2 HP.
	}

	RoyalHoneySigil: {
		DisplayName: Royal Honey Sigil
		Tooltip: Create healing bee circle at 1/2 HP.
	}

	HoneyFangBlade: {
		DisplayName: Honey Fang Blade
		Tooltip: ""
	}

	StingerBlowpipe: {
		DisplayName: Stinger Blowpipe
		Tooltip: ""
	}

	HoneyflowCharm: {
		DisplayName: Honeyflow Charm
		Tooltip:
			'''
			Move through honey at normal speeds.
			1 life regeneration.
			'''
	}
}

